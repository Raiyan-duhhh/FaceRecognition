<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.FaceRecognition" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Set the splash screen background -->
        <item name="windowSplashScreenBackground">#FFFFFF</item>
        <!-- Use the application theme for the actual activity -->
        <item name="postSplashScreenTheme">@style/Theme.FaceRecognition</item>

        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_round</item>

        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
    </style>
</resources>